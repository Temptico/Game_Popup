{% comment %}
  Kodra Play – app embed block.
  All settings are managed in the Kodra Play app and published to the
  app-data metafield app.metafields.gamediscount.config — nothing to edit here.
{% endcomment %}
{%- comment -%} Brand colors (Settings → Brand) for the app's "Use my store colors" button. {%- endcomment -%}
{%- assign gd_brand = shop.brand.colors -%}
{%- if gd_brand.primary.size > 0 or gd_brand.secondary.size > 0 -%}
  <script type="text/plain" id="gd-brand">{{ gd_brand.primary[0].background }},{{ gd_brand.secondary[0].background }}</script>
{%- endif -%}
{%- assign gd_config = app.metafields.gamediscount.config -%}
{%- if gd_config != blank and gd_config.value.popups.size > 0 -%}
  <script type="application/json" id="gd-config">{{ gd_config.value | json }}</script>
  <script>
    window.GameDiscountContext = {
      template: {{ template.name | json }},
      locale: {{ request.locale.iso_code | json }},
      privacy: {{ shop.privacy_policy.url | json }},
      country: {{ localization.country.iso_code | json }},
      designMode: {{ request.design_mode | json }},
      alwaysShow: {{ block.settings.always_show | json }},
      proxy: "/apps/gamediscount",
      assets: {
        ui: {{ 'gd-ui.js' | asset_url | json }},
        paddle: {{ 'gd-paddle.js' | asset_url | json }},
        flipper: {{ 'gd-flipper.js' | asset_url | json }},
        pong: {{ 'gd-pong.js' | asset_url | json }},
        wheel: {{ 'gd-wheel.js' | asset_url | json }},
        fx: {{ 'gd-fx.js' | asset_url | json }}
      }
    };
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Kodra Play popup",
  "target": "body",
  "javascript": "game-popup.js",
  "stylesheet": "game-popup.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure the discount, game and texts in the Kodra Play app (Apps → Kodra Play)."
    },
    {
      "type": "checkbox",
      "id": "always_show",
      "label": "Test mode: show immediately and ignore 'already played' memory",
      "info": "Turn off before going live.",
      "default": false
    }
  ]
}
{% endschema %}
