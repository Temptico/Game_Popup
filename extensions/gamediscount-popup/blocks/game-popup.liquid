{% comment %}
  Enigma Play – app embed block.
  All settings are managed in the Enigma Play app and published to the
  app-data metafield app.metafields.gamediscount.config — nothing to edit here.
{% endcomment %}
{%- assign gd_config = app.metafields.gamediscount.config -%}
{%- if gd_config != blank and gd_config.value.popups.size > 0 -%}
  <script type="application/json" id="gd-config">{{ gd_config.value | json }}</script>
  <script>
    window.GameDiscountContext = {
      template: {{ template.name | json }},
      locale: {{ request.locale.iso_code | json }},
      designMode: {{ request.design_mode | json }},
      alwaysShow: {{ block.settings.always_show | json }},
      proxy: "/apps/gamediscount",
      assets: {
        paddle: {{ 'gd-paddle.js' | asset_url | json }},
        flipper: {{ 'gd-flipper.js' | asset_url | json }},
        pong: {{ 'gd-pong.js' | asset_url | json }},
        fx: {{ 'gd-fx.js' | asset_url | json }}
      }
    };
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Enigma Play popup",
  "target": "body",
  "javascript": "game-popup.js",
  "stylesheet": "game-popup.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure the discount, game and texts in the Enigma Play app (Apps → Enigma Play)."
    },
    {
      "type": "checkbox",
      "id": "always_show",
      "label": "Test mode: show immediately and ignore 'already played' memory",
      "info": "Turn off before going live.",
      "default": false
    }
  ]
}
{% endschema %}
