// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Popup {
  id             String   @id @default(cuid())
  shop           String
  name           String
  active         Boolean  @default(true)
  discountCode   String
  delaySec       Int      @default(15)
  surviveSec     Int      @default(15)
  vx             Float    @default(4.5)
  vy             Float    @default(-5.0)
  maxAttempts    Int      @default(3)
  primaryColor   String   @default("#830522")
  accentColor    String   @default("#d9caa0")
  target         String   @default("all")
  requireConsent Boolean  @default(true)
  autoApply      Boolean  @default(true)
  // "static" = one shared code (discountCode); "unique" = a single-use code is
  // created per winner (Pro). discountCode is then only a fallback.
  codeMode       String   @default("static")
  discountType   String   @default("percentage") // percentage | fixed
  discountValue  Float    @default(10)
  codePrefix     String   @default("WIN")
  codeExpiryDays Int      @default(7) // 0 = never expires
  gameType       String   @default("paddle") // paddle | flipper
  trigger        String   @default("both") // both | delay | exit
  frequency      String   @default("session") // session | day | week | always
  teaser         Boolean  @default(true)
  tiered         Boolean  @default(false)
  tierValues     String   @default("15,10,5") // best → worst attempt
  urgencyMinutes Int      @default(0)
  // JSON-encoded CustomStrings ({ sl: { introTitle: "..." }, ... })
  strings        String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  events         Event[]
  claims         Claim[]

  @@index([shop])
}

// Funnel events from the storefront. No customer PII is stored here.
model Event {
  id        String   @id @default(cuid())
  shop      String
  popupId   String
  popup     Popup    @relation(fields: [popupId], references: [id], onDelete: Cascade)
  // view | submit | play | win
  type      String
  createdAt DateTime @default(now())

  @@index([shop, type, createdAt])
  @@index([popupId, type])
}

// One per (popup, email): issued by /proxy/subscribe, redeemed by /proxy/claim.
// Ties every win to a submitted email, so a code can't be minted without
// playing and each email gets at most one code per popup.
model Claim {
  id         String    @id @default(cuid())
  token      String    @unique
  shop       String
  popupId    String
  popup      Popup     @relation(fields: [popupId], references: [id], onDelete: Cascade)
  // sha256(shop:email) – no plain-text PII stored
  emailHash  String
  issuedAt   DateTime  @default(now())
  code       String?
  discountId String?
  valueLabel String?
  expiresAt  DateTime?
  claimedAt  DateTime?

  @@unique([popupId, emailHash])
  @@index([shop, claimedAt])
}
